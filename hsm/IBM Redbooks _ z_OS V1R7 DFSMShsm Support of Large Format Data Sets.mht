	color:#000;=20
	background-color: #fff;
	font-size:21px;=20
	font-weight:bold;=20
}

#content,
#content-head,
#content-main,
#content-sidebar {
	width: 100% !important;
	margin: 0 !important;
	padding: 0 !important;
}
#content-head {margin-top: 44px !important;}
#content-main {
	float: none !important;
	border-right: 0;
	border-bottom: 1px dashed #000;
}
