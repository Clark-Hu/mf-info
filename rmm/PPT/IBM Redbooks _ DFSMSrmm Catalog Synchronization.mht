function queryFormat(origStr, findText, replaceText) {
	var pos =3D 0=09
	var len =3D findText.length
=09
	pos =3D origStr.indexOf(findText)
	while (pos !=3D -1) {
		var q =3D 0
		var newSep =3D replaceText
		preString =3D origStr.substring(0, pos)=09
	=09
		// skip text in quotes
		for (var i =3D 0; i < preString.length+1; i++) {
		   if (preString.charAt(i)=3D=3D'"') q++;
		}
		if (q/2 !=3D Math.round(q/2)) newSep =3D '+'
	=09
		postString =3D origStr.substring(pos+1, origStr.length)
		origStr =3D preString + newSep + postString
		pos =3D origStr.indexOf(findText)
	=09
	}
	return origStr
}
